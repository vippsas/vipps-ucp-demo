# ==============================================
# Vipps Checkout API Configuration
# See: https://developer.vippsmobilepay.com/api/checkout/
# ==============================================

# API Environment
# Use https://apitest.vipps.no for test, https://api.vipps.no for production
VIPPS_API_BASE_URL=https://apitest.vipps.no

# ==============================================
# API Credentials (Required)
# Get these from the Vipps Portal: https://portal.vipps.no
# See: https://developer.vippsmobilepay.com/docs/knowledge-base/api-keys/
# ==============================================

# Client ID - the "username" for API authentication
VIPPS_CLIENT_ID=your-client-id-here

# Client Secret - the "password" for API authentication
VIPPS_CLIENT_SECRET=your-client-secret-here

# Subscription Key (Ocp-Apim-Subscription-Key)
VIPPS_SUBSCRIPTION_KEY=your-subscription-key-here

# Merchant Serial Number (MSN) - assigned by Vipps
VIPPS_MERCHANT_SERIAL_NUMBER=123456

# ==============================================
# System Identification Headers (Required)
# See: https://developer.vippsmobilepay.com/docs/knowledge-base/http-headers
# ==============================================

# Name of your ecommerce solution (max 30 chars)
VIPPS_SYSTEM_NAME=UCP-POC

# Version of your ecommerce solution (max 30 chars)
VIPPS_SYSTEM_VERSION=1.0.0

# Name of the plugin/integration (max 30 chars)
VIPPS_PLUGIN_NAME=ucp-checkout

# Version of the plugin/integration (max 30 chars)
VIPPS_PLUGIN_VERSION=1.0.0

# ==============================================
# Merchant Configuration
# ==============================================

# URL where Vipps will send callbacks when payment is completed
# Must be publicly accessible (use ngrok for local development)
VIPPS_CALLBACK_URL=https://your-domain.com/api/vipps/callback

# URL where customer is redirected after checkout completes
VIPPS_RETURN_URL=https://your-domain.com/checkout/complete

# Secret token for authenticating callbacks from Vipps (optional but recommended)
VIPPS_CALLBACK_TOKEN=your-secret-callback-token

# URL to your terms and conditions page
VIPPS_TERMS_URL=https://your-domain.com/terms

# ==============================================
# UCP Signing Keys (for webhook signatures)
# These are required for the business service to sign webhooks
# Get the actual keys from the team's shared .env file
# ==============================================

# Key ID for the signing key (must match what's in /.well-known/ucp)
UCP_SIGNING_KEY_ID=add-your-key-id-here

# Private key in JWK format (JSON, single line)
UCP_SIGNING_PRIVATE_KEY=add-your-private-key-here

# Public key in JWK format (JSON, single line) - must match what's in well-known/profile.json
UCP_SIGNING_PUBLIC_KEY=add-your-public-key-here
